# GEMINI_API_KEY: Optional for Gemini AI coaching & enterprise agent responses.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this application is hosted (e.g. https://radiantsparkllc.com).
APP_URL="MY_APP_URL"

# VITE_API_BASE_URL: Optional full origin of the active Node/Express backend (e.g. https://your-cloud-run-url.run.app)
# when serving frontend statically on GitHub Pages (leave blank when serving frontend+backend together on server.ts).
VITE_API_BASE_URL=""

# STRIPE_SECRET_KEY: Server-only Stripe Secret Key (sk_live_... or sk_test_...) linked to your Stripe Business account.
# Enables worldwide multi-currency card, Apple Pay, Google Pay & subscription payouts directly to your Stripe account.
STRIPE_SECRET_KEY=""

# STRIPE_WEBHOOK_SECRET: Signing secret (whsec_...) for verifying POST /api/stripe/webhook events.
STRIPE_WEBHOOK_SECRET=""

# STRIPE_PAYMENT_LINK_URL: Optional Stripe Payment Link URL for pure-static fallback redirects.
STRIPE_PAYMENT_LINK_URL=""
VITE_STRIPE_PAYMENT_LINK_URL=""

# LIFESPARK_SESSION_SECRET: Random secret for signing customer login session tokens.
LIFESPARK_SESSION_SECRET=""

# Affiliate & Webhook optional server configuration
AMAZON_AFFILIATE_TAG=""
AMAZON_INDIA_TAG=""
DEALS_WEBHOOK_SECRET=""

# Optional SMTP email notifications for B2B RFQ inquiries
SMTP_HOST=""
SMTP_USER=""
SMTP_PASS=""
